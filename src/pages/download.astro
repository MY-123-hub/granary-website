---
import { sitePath } from "../lib/paths";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { currentRelease as release, formatSize } from "../data/product";
const available = release.status === "published" && !!release.downloadUrl;
---

<Layout
  title="下载中心"
  description="获取智慧粮仓检测系统 Windows 版本、安装包信息、SHA-256 校验值和安装准备说明。"
>
  <section class="page-intro container">
    <span class="feature-topic">下载中心</span>
    <h1>
      在您的电脑上，
      <br />
      开始看清粮情。
    </h1>
    <p>
      Windows 本地部署。
      <br />
      版本、文件与安装准备，都在这里。
    </p>
  </section>
  <section class="download-layout container">
    <div class="release-card">
      <div class="release-card-top">
        <span class="windows-tile">
          <Icon name="windows" size={31} />
        </span>
        <span class:list={["badge", { "badge-neutral": !available }]}>
          {available ? "正式发布" : "待公开发布"}
        </span>
      </div>
      <h2>Windows 版</h2>
      <p class="release-version">
        v{release.version}
        <span>x64 安装包</span>
      </p>
      <p class="release-description">
        {available
          ? "下载安装包，在本地部署粮情检测系统。"
          : "候选安装包已准备，公开下载将在发布后开放。"}
      </p>
      {available ? (
        <a class="button download-main" href={sitePath(release.downloadUrl!)}>
          <Icon name="download" />
          下载安装包
        </a>
      ) : (
        <button
          class="button download-main"
          disabled
          aria-describedby="release-status"
        >
          <Icon name="download" />
          安装包待发布
        </button>
      )}
      <p class="release-status" id="release-status">
        {available
          ? "安装前请核对版本与文件校验值。"
          : "当前无公开下载链接。Windows 实机验收待完成。"}
      </p>
      <dl class="release-metadata">
        <div>
          <dt>当前版本</dt>
          <dd>
            {release.version}
            {!available && "（候选）"}
          </dd>
        </div>
        <div>
          <dt>发布日期</dt>
          <dd>{release.publishedAt || "尚未公开发布"}</dd>
        </div>
        <div>
          <dt>准备日期</dt>
          <dd>{release.preparedAt}</dd>
        </div>
        <div>
          <dt>安装包大小</dt>
          <dd>
            {formatSize(release.sizeBytes)}
            <small>{release.sizeBytes?.toLocaleString("en-US")} 字节</small>
          </dd>
        </div>
        <div>
          <dt>运行平台</dt>
          <dd>
            Windows x64<small>具体系统要求随正式版确认</small>
          </dd>
        </div>
      </dl>
    </div>
    <aside class="download-sidebar">
      <div class="download-notes">
        <h2>{available ? "这个版本有什么更新" : "首版候选内容"}</h2>
        <ul class="quiet-list">
          {release.releaseNotes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
        <a href={sitePath("/changelog/")} class="text-link">
          查看完整更新记录
          <Icon name="chevron" size={16} />
        </a>
      </div>
      <div class="installation-overview">
        <h2>安装前，准备这些</h2>
        <ol>
          <li>
            <strong>确认运行环境</strong>
            <p>正式版发布时将提供系统要求与安装步骤。</p>
          </li>
          <li>
            <strong>准备设备与通讯参数</strong>
            <p>记录 USB RS485 串口、分机地址和设备要求的通信参数。</p>
          </li>
          <li>
            <strong>准备整机授权</strong>
            <p>客户系统采用离线授权，需配套签发方提供的授权文件。</p>
          </li>
        </ol>
        <a class="text-link" href={sitePath("/docs/installation/")}>
          查看安装文档入口
          <Icon name="chevron" size={16} />
        </a>
      </div>
    </aside>
  </section>
  <section class="checksum-section container">
    <div>
      <span class="feature-topic">文件完整性</span>
      <h2>核对您拿到的安装包。</h2>
      <p>
        {available
          ? "SHA-256 对应当前公开版本。"
          : "SHA-256 根据本地候选安装包计算。"}
        <br class="desktop-break" />
        请使用对应版本的校验值核对下载文件。
      </p>
    </div>
    <div class="checksum-box">
      <div class="checksum-heading">
        <span>SHA-256</span>
        {release.sha256 && (
          <button
            class="text-button"
            data-copy={release.sha256}
            aria-label="复制 SHA-256 校验值"
          >
            <Icon name="copy" size={15} />
            <span>复制校验值</span>
          </button>
        )}
      </div>
      <code>{release.sha256 || "正式发布时提供"}</code>
      <details>
        <summary>
          如何在 Windows 中校验
          <Icon name="chevron" size={15} />
        </summary>
        <p>打开 PowerShell，使用实际文件路径运行：</p>
        <code class="command-code">
          Get-FileHash -Algorithm SHA256 -LiteralPath '.\{release.fileName}'
        </code>
        <p>将输出的 Hash 与本页对应版本校验值比较。</p>
      </details>
      <p class="copy-status" role="status" aria-live="polite"></p>
    </div>
  </section>
  <section class="download-help container">
    <h2>先了解，再部署。</h2>
    <a href={sitePath("/product/")}>
      查看产品功能
      <Icon name="chevron" size={17} />
    </a>
    <a href={sitePath("/docs/")}>
      浏览使用文档
      <Icon name="chevron" size={17} />
    </a>
  </section>
</Layout>
<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy]")
    .forEach((button) =>
      button.addEventListener("click", async () => {
        const status = button
          .closest(".checksum-box")
          ?.querySelector(".copy-status");
        try {
          await navigator.clipboard.writeText(button.dataset.copy!);
          if (status) status.textContent = "校验值已复制。";
        } catch {
          if (status)
            status.textContent = "自动复制不可用，请选中上方校验值手动复制。";
        }
      }),
    );
</script>
