---
import { sitePath } from "../lib/paths";
import Layout from "../layouts/Layout.astro";
---

<Layout title="页面未找到">
  <section class="not-found container">
    <span class="feature-topic">404</span>
    <h1>这页暂时找不到。</h1>
    <p>您可以返回首页，或前往下载中心。</p>
    <div class="hero-actions">
      <a class="button" href={sitePath("/")}>
        返回首页
      </a>
      <a class="button button-outline" href={sitePath("/download/")}>
        下载中心
      </a>
    </div>
  </section>
</Layout>
